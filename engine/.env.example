# Engine environment — names only, never values.
#
# Copy to `engine/.env.local` and fill in there. `.env.local` is gitignored
# (`.env.*` with an exception for this file); nothing here is a real key.
#
# Test-mode Stripe keys only until cutover. A `sk_live_` or `rk_live_` value in
# a local file is a mistake, not a deployment.

# Supabase: the local stack on 54421–54424, or the project URL and its
# service-role key. The engine writes with the service role; the website never
# holds it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe. `stripe config --list` shows the CLI profiles on this machine;
# the test key comes from the profile, never from a file in this repo.
STRIPE_SECRET_KEY=
# Printed by `stripe listen --forward-to localhost:3001/api/stripe/webhook`.
# It changes every time the listener restarts.
STRIPE_WEBHOOK_SECRET=

# Resend. Domain `evolutionstables.nz` is verified.
ENGINE_EMAIL_API_URL=
ENGINE_EMAIL_API_KEY=
ENGINE_EMAIL_FROM=
ENGINE_FOUNDER_EMAIL=

# Guards POST /api/purchase/expire. `openssl rand -hex 32`.
# The same value is the GitHub secret ENGINE_EXPIRE_TOKEN; production keeps its
# own, and the local file's value never leaves this machine.
ENGINE_EXPIRE_SECRET=
