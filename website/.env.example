# The website's read client. Names only — never values, and never the secret key.
#
# Both names are read by website/src/lib/supabaseRead.ts.
#
# No NEXT_PUBLIC_ prefix, deliberately. Every read in this app is server-side, so
# the key never needs to reach a browser, and the prefix is what would let Next
# inline it into a client bundle. A logged-out visitor still reads through the
# `anon` role, so row level security applies exactly as migration 00009 intends.
#
# Local stack values come from `supabase status` at the repo root: the API URL is
# 127.0.0.1:54421 and the anon/publishable key is printed alongside it. At the
# domain cutover these two become the production project's URL and anon key.
#
# Copy this file to website/.env.local, which .gitignore excludes.

WEBSITE_SUPABASE_URL=
WEBSITE_SUPABASE_ANON_KEY=

# The public origin the horse images are served from — Cloudflare R2, behind the
# CDN. Read by website/src/lib/site.ts and by website/next.config.ts, which adds it
# to the image optimizer's allow-list.
#
# An origin only, no key: these objects are public by design, and the upload
# credentials live in the engine's environment, never here.
#
# Unset is a normal state. Every page that shows an image is server-rendered per
# request, and the listing falls back to the no-photo placeholder, so a build and a
# CI run need no R2 value at all. A malformed value still throws, which is the
# difference between "not configured yet" and "configured wrongly".
WEBSITE_R2_PUBLIC_URL=

# Step 8 — Engine purchase API origin and buy-path toggle.
#
# The website never prices, never compiles templates, and holds no Stripe secret.
# All quote calculations, legal compilations, Identity sessions, and Checkout
# sessions come from the engine over HTTP.
#
# WEBSITE_BUY_ENABLED stays off in preview until Step 10's readiness flip
# (PLAN.md:318). When set to 'true', Available listings render the Buy Now control.
WEBSITE_ENGINE_URL=
WEBSITE_BUY_ENABLED=false
